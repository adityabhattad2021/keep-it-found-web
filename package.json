{
  "name": "found-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/journal-server.tsx --outDir .journal-ssr && node scripts/generate-journal-pages.mjs",
    "check": "npm run test && npm run lint && npm run build",
    "check:voting-config": "node scripts/check-roadmap-config.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test src/features/roadmap-voting/*.test.ts tests/*.test.mjs"
  },
  "dependencies": {
    "firebase": "^12.17.1",
    "marked": "^13.0.3",
    "motion": "^13.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "firebase-tools": "^15.26.0",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0"
  }
}
